# Copy this file to .env and fill in your values.
# .env is gitignored - never commit secrets.

# Ollama Cloud (recommended - larger models on Ollama's servers)
# Get your API key at https://ollama.com/settings/keys
OLLAMA_API_KEY=your_ollama_cloud_key_here

# Optional: model (use gpt-oss:120b for Ollama Cloud)
# OLLAMA_MODEL=gpt-oss:120b

# Optional: host (default: https://ollama.com when API key set, else http://localhost:11434)
# OLLAMA_HOST=https://ollama.com

# ── PCOSense Phase 3 (FastAPI + Shiny + Supabase) ───────────────────────────
# Shiny calls the API (default http://127.0.0.1:8000)
# PCOSENSE_API_URL=http://127.0.0.1:8000

# Supabase — create a project at https://supabase.com and run README SQL in SQL Editor
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_KEY=your_anon_or_service_role_key

# Optional: comma-separated origins for browser calls (default * for local dev)
# CORS_ORIGINS=*

# ── Zena App V2 (optional hosted password gate) ─────────────────────────────
# If set, users must enter this password in the sidebar before the profile form appears.
# Put the same password in your Canvas .docx for the instructor.
# ZENA_APP_PASSWORD=your_team_secret   # for shiny run src/app/zena_app.py

# PCOSENSE_APP_PASSWORD=your_team_secret   # for shiny run app.py (PCOSense)
